# ─── Server ───────────────────────────────────────
PORT=4001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:4002

# ─── AI Analyzer Service ─────────────────────────
AI_SERVICE_URL=http://localhost:4000
AI_SERVICE_TIMEOUT_MS=30000

# ─── File uploads ────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── MongoDB ──────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/radiology-copilot

# ─── Redis ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Auth ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# ─── Rate Limiting ───────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
