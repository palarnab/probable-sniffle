# ─── Server ───────────────────────────────────────
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ─── Model ────────────────────────────────────────
MODEL_NAME=DenseNet121-CheXNet
MODEL_VERSION=1.0.0
CONFIDENCE_THRESHOLD=0.3
DEVICE=auto

# ─── Grad-CAM ────────────────────────────────────
ENABLE_GRADCAM=true
GRADCAM_LAYER=features.denseblock4.denselayer16.conv2

# ─── Paths ────────────────────────────────────────
WEIGHTS_DIR=./weights
HEATMAP_COLORMAP=jet
